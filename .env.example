# 复制为仓库根目录的 .env 后可覆盖。

DATABASE_URL=postgresql://advisor:advisor@localhost:5432/advisor
# INFO 只打阶段摘要。改成 DEBUG 后，本机终端会打印每一步的完整参数。
LOG_LEVEL=INFO

# 主模型。三项都留空时，发送消息会提示还没配置，已保存的历史仍可打开。
# LLM_BASE_URL 填所选厂商的兼容根路径。DeepSeek 固定为 https://api.deepseek.com。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 下面这些键留给后面的步骤，当前不会读取。
LLM_SMALL_MODEL=

# 联网搜索。页面开关打开后，模型才看得到 web_search。
# 请求发到 {SEARCH_BASE_URL}/v2/ai_search/web_search，请求头用 Bearer。
# 密钥留空时，开关打开也不会访问外网，模型会被告知这一轮不能联网。
SEARCH_BASE_URL=https://qianfan.baidubce.com
SEARCH_API_KEY=

# PDF 中文字体。留空时依次尝试宋体、冬青黑体、华文黑体，以及 Linux 上的 Noto CJK。
# PDF_FONT_PATH 指向 .ttf、.otf 或 .ttc。集合字体要再填 PDF_FONT_FAMILY 的 PostScript 名。
PDF_FONT_PATH=
PDF_FONT_FAMILY=

# 嵌入模型。npm run index-knowledge 会把 rag 文档切分并写入向量。
# 三项留空时，对话仍然可用，只是不检索知识库。
# EMBEDDING_BASE_URL 填兼容根路径，请求发到 {BASE_URL}/embeddings。
# EMBEDDING_DIMENSIONS 必须和模型输出维度一致。bge-m3 是 1024。换维度后要删掉 knowledge_chunks 再灌库。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024

# 重排。三项都留空时，对话只按向量距离取前 6 段。填齐后先召回 6 段，重排后把前 3 段放进提示。
# RERANK_BASE_URL 填兼容根路径，请求发到 {BASE_URL}/rerank。
# 接口与 Cohere、SiliconFlow 相同：query、documents、top_n，返回 index 和 relevance_score。
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
WORKSPACE_ROOT=
PDF_MCP_COMMAND=
